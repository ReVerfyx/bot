# ── Telegram ─────────────────────────────────────────────────────────────
BOT_TOKEN=123456:AA...                # @BotFather
ADMIN_IDS=111111111,222222222         # ID админов через запятую (@userinfobot)
ADMIN_CHAT_ID=                        # чат/группа куда падают заявки (можно оставить пустым)
ADMIN_SECRET=                         # кодовое слово для тихого входа в админку

# ── Хранилище (GitHub Issues) ────────────────────────────────────────────
# В GitHub Actions подставляются автоматически, локально — заполнить вручную
GH_STORE_TOKEN=                       # PAT с правами issues:write (в Actions = GITHUB_TOKEN)
GH_STORE_REPO=ReVerfyx/bot            # owner/repo приватного репозитория

# ── Оплата ───────────────────────────────────────────────────────────────
CRYPTOBOT_TOKEN=                      # токен @CryptoBot / @send (пусто = только ручная оплата)
CRYPTOBOT_API=https://pay.crypt.bot/api

# ── Runtime ──────────────────────────────────────────────────────────────
RUN_DURATION_SECONDS=20700            # 5ч45м, потом graceful stop и рестарт воркфлоу
CONFIG_PATH=config.yml
LOG_LEVEL=INFO
